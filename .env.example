# ─── Copy this file to .env and fill in your values ───────────────────────────
# NEVER commit .env to git

# Django Core
SECRET_KEY=replace-with-a-long-random-secret-from-a-password-manager
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated explicit browser origins. Do not use wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Database Configuration ──────────────────────────────────────────────────
# Choose ONE of the following options:

# ── OPTION 1: TiDB Cloud (Serverless / Dedicated) ───────────────────────────
DB_ENGINE=django.db.backends.mysql
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com   # TiDB Cloud Host
DB_PORT=4000                                              # TiDB default port is 4000
DB_USER=your_prefix.root                                  # TiDB username
DB_PASSWORD=your_tidb_password                            # TiDB password
DB_NAME=attendance_FR                                     # TiDB database name
DB_USE_SSL=True                                           # TiDB Cloud requires SSL
DB_SSL_CA=isrgrootx1.pem                                  # Uses isrgrootx1.pem certificate in project root

# ── OPTION 2: Local XAMPP MySQL / phpMyAdmin ────────────────────────────────
# (Uncomment below and comment out Option 1 if running locally on XAMPP)
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=attendance_db
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USE_SSL=False

# ─── Face Recognition ─────────────────────────────────────────────────────────
# Lower tolerance = stricter matching (0.38 recommended; rejects look-alikes)
FACE_RECOGNITION_TOLERANCE=0.38
MIN_FACE_CONFIDENCE=0.62
FACE_MATCH_MARGIN=0.08
# Consecutive matching frames of the same student before attendance is marked
FACE_CONSENSUS_FRAMES=3
# Near-identical consecutive frames (replayed image) do not count toward consensus
FACE_REPLAY_EPSILON=0.002
# Enrollment: reject a face this close to another student's face (1 student = 1 face)
FACE_DUPLICATE_TOLERANCE=0.5
# Passive anti-spoofing (MiniFASNet): minimum "live" probability per frame (0-1)
FACE_ANTISPOOF_THRESHOLD=0.7
# Enrollment: re-reads per countdown frame, averaged into the stored face code
FACE_ENROLL_JITTERS=4
# Landmark quality gates (degrees / eye aspect ratio). Frames outside these are skipped.
FACE_SCAN_MAX_YAW=20
FACE_SCAN_MAX_PITCH=25
FACE_SCAN_MIN_EAR=0.17
FACE_ENROLL_MAX_YAW=15
FACE_ENROLL_MAX_PITCH=20
FACE_ENROLL_MIN_EAR=0.2
LATE_THRESHOLD_MINUTES=15

# ─── Brute-force protection & rate limits ─────────────────────────────────────
# Lock a username+IP pair after this many failed logins, for this many minutes
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Per-account cap across ALL IPs within the window (then locked until the window ends or
# an admin runs `python manage.py unlock_login <username>`)
LOGIN_ACCOUNT_MAX_FAILURES=100
LOGIN_ACCOUNT_WINDOW_HOURS=24
# Access token lifetime in minutes (renewed silently with the refresh token)
JWT_ACCESS_MINUTES=15

# ─── Browser login through the Cloudflare Pages proxy (httpOnly refresh cookie) ──
# Shared secret with the Pages Function (PROXY_SECRET there). Leave empty for local dev:
# the Vite dev server proxies /api/token and /api/auth/logout instead.
AUTH_PROXY_SECRET=
# Encryption key for two-step sign-in secrets (authenticator apps). Optional: falls back to
# SECRET_KEY. Set a long random value in production so rotating SECRET_KEY later does not
# switch off everyone's two-step sign-in. Never change it once people have turned 2FA on.
TWO_FACTOR_KEY=
# Defaults to true when AUTH_PROXY_SECRET is set: token endpoints refuse direct calls.
# AUTH_PROXY_REQUIRED=true
# Cookie needs HTTPS in production; defaults to false only when DEBUG=True.
# REFRESH_COOKIE_SECURE=true
THROTTLE_LOGIN=10/min
THROTTLE_TOKEN_REFRESH=30/min
THROTTLE_FACE_RECOGNIZE=180/min
THROTTLE_FACE_ENROLL=30/min
THROTTLE_REGISTER=30/hour
THROTTLE_TWO_FACTOR=10/min
THROTTLE_PASSWORD_CHANGE=5/min
# Reverse proxies in front of Django (0 locally, 1 on Render) for real client IPs
TRUSTED_PROXY_COUNT=0

# ─── Cloudflare Turnstile CAPTCHA (public registration) ───────────────────────
# Site key (served to the browser by the API) and secret key (backend only).
# Register your site at https://dash.cloudflare.com/turnstile. Add both your production
# domain and localhost. Turnstile is turned OFF when TURNSTILE_SECRET_KEY is blank.
# For local dev, use test keys that always pass (see DOCUMENTATION.md §8).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ─── Face Enrollment Gate ──────────────────────────────────────────────────────
# Students who have no face photo are blocked from using the app until they enroll a face
# (self-registered or admin-created students alike). Allowed paths without a face: sign-in,
# token refresh, face enrollment self-service and health check. Turned off in tests by default.
FACE_ENROLLMENT_GATE=True

# ─── Upload limits (bytes / pixels) ───────────────────────────────────────────
FACE_MAX_FRAME_BYTES=2097152
FACE_MAX_FRAME_DIMENSION=4096
MAX_IMAGE_UPLOAD_BYTES=2097152
# Face photos are private; the API hands out signed links that expire after this many seconds
FACE_PHOTO_LINK_SECONDS=300

# ─── Cache (locmem for dev, Redis URL for prod) ────────────────────────────────
# CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache

# ─── Cloudinary Persistent Media (Face & Profile Images on Cloud) ───────────
# Free account at https://cloudinary.com -> Dashboard:
# (Optional for local dev - if blank, files save locally in media/)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

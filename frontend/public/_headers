# Cloudflare Pages response headers (applies to the deployed site only; `npm run dev` ignores it).
# Content-Security-Policy: the browser only runs/loads code and data from the sources listed.
# An injected script from anywhere else is blocked, so it cannot read the login tokens.
#
#   script-src   own files only (bundle + self-hosted face-api in /vendor/); no inline or eval'd code
#   frame-src    none (no third-party iframes)
#   style-src    own CSS + Google Fonts CSS; 'unsafe-inline' only because React uses style={...}
#   connect-src  Django API on Render, PSGC address lookup (face-api models are self-hosted)
#   img-src      own files, API (signed face photos), Cloudinary (profile images)
#
# If the API moves, update https://attendance-face-recognition-1.onrender.com below.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; frame-src 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://attendance-face-recognition-1.onrender.com https://res.cloudinary.com; connect-src 'self' https://attendance-face-recognition-1.onrender.com https://psgc.gitlab.io; media-src 'self' blob: mediastream:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Vendored libraries live under a versioned folder, so they can be cached for a long time.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
